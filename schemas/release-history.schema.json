{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "PluriBooks release history v1",
  "type": "object",
  "additionalProperties": false,
  "required": ["schemaVersion", "channel", "versions"],
  "properties": {
    "schemaVersion": { "const": 1 },
    "channel": { "enum": ["preview", "stable"] },
    "versions": {
      "type": "array", "maxItems": 10,
      "items": {
        "type": "object", "additionalProperties": false,
        "required": ["versionCode", "versionName", "publishedAt", "notes", "releaseUrl"],
        "properties": {
          "versionCode": { "type": "integer", "minimum": 1 },
          "versionName": { "type": "string", "pattern": "^[0-9]+\\.[0-9]+\\.[0-9]+(?:-[0-9A-Za-z.-]+)?$" },
          "publishedAt": { "type": "string", "format": "date-time" },
          "notes": { "type": "array", "maxItems": 8, "items": { "type": "string", "minLength": 1, "maxLength": 500 } },
          "releaseUrl": { "type": "string", "format": "uri", "pattern": "^https://github\\.com/EraserHead8/pluribooks-distribution/releases/tag/[^/]+$" }
        }
      }
    }
  }
}
